{
	"name": "@portage/desktop",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test tests",
		"contrast": "bun run scripts/contrast.ts",
		"a11y": "bun run scripts/contrast.ts",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"sidecar": "bun run scripts/sidecar.ts",
		"tauri": "tauri"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
