{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"moduleResolution": "bundler",
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		},
		"types": ["$app/types", "bun"]
	},
	"include": ["src", "scripts", "vite.config.ts", "prettier.config.js", "tests"]
}
