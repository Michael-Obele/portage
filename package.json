{
  "name": "portage",
  "version": "0.1.0",
  "private": true,
  "description": "Move a phone's downloads onto an archive drive safely — verified, resumable, and with the phone copy deleted only after proof.",
  "type": "module",
  "module": "src/cli/index.ts",
  "bin": {
    "portage": "src/cli/index.ts"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "start": "bun run src/cli/index.ts",
    "dev": "bun --watch src/cli/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --minify --sourcemap --outfile dist/portage src/cli/index.ts",
    "doctor": "bun run src/cli/index.ts doctor"
  },
  "dependencies": {
    "parse-torrent-title": "3.0.1",
    "smol-toml": "1.9.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "latest",
    "ink": "8.0.0",
    "react": "19.3.0",
    "typescript": "5.9.3"
  }
}