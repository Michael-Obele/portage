{
  "name": "portage",
  "version": "0.1.18",
  "private": true,
  "description": "Move a phone's downloads onto an archive drive safely — verified, resumable, and with the phone copy deleted only after proof.",
  "type": "module",
  "imports": {
    "#lib/*": "./src/*"
  },
  "module": "src/cli/index.ts",
  "bin": {
    "portage": "src/cli/index.ts"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "start": "bun run src/serve/main.ts",
    "dev": "bun --watch src/serve/main.ts",
    "test": "bun test --preload ./scripts/preload.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "build:scanner": "bun run scripts/scanner.ts"
  },
  "dependencies": {
    "smol-toml": "1.9.0",
    "svelte": "5.38.7",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "svelte": "5.38.7",
    "typescript": "5.9.3"
  }
}