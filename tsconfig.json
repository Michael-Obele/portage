{
  "compilerOptions": {
    // Environment
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bun — `bun-types` is the legacy entry, `bun` is what @types/bun ships today
    // `svelte` contributes the ambient RUNE declarations ($state, $derived,
    // $effect, $effect.root). Without it tsc reads `.svelte.ts` as plain
    // TypeScript, `$state(...)` is an unresolved identifier, and every field
    // inferred from it degrades to `any` — which is how a typecheck passes on a
    // file the compiler never actually understood.
    "types": ["bun", "svelte"],

    // Strictness — every switch on a state must be exhaustive
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "noEmit": true,

    // Resolution
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
